# ===== LLM 后端：二选一 =====
# ollama = 本地模型（零成本）；dashscope = 千问 API（质量更高，按 token 计费）
LLM_BACKEND=ollama

# --- ollama 本地（OpenAI 兼容接口）---
OLLAMA_BASE_URL=http://localhost:11434/v1
# MODEL_STRONG=qwen3:8b
# MODEL_FAST=qwen3.5:4b

# --- 千问 API（LLM_BACKEND=dashscope 时必填；https://bailian.console.aliyun.com 获取 key）---
DASHSCOPE_API_KEY=sk-你的百炼APIKey
# MODEL_STRONG=qwen-plus
# MODEL_FAST=qwen-turbo

# Tavily 搜索 API（https://tavily.com 注册，免费额度 1000 次/月）
TAVILY_API_KEY=tvly-你的TavilyAPIKey

# 反馈回路控制
MAX_LOOPS=3
CRITIC_PASS_SCORE=6
